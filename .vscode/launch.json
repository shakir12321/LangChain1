  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: main.py (Ollama, deepseek-r1:1.5b)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "args": [
        "--attachment",
        "person.txt",
        "--provider",
        "ollama",
        "--model",
        "deepseek-r1:1.5b",
        "--temperature",
        "0"
      ]
    }
  ]
}
